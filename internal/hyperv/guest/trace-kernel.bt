#!/usr/bin/env bpftrace
/* Ubuntu Noble bpftrace 0.20; Linux 6.8 raw tracepoint signatures:
 * sched_process_fork(task_struct *parent, task_struct *child)
 * sched_process_exec(task_struct *p, pid_t old_pid, linux_binprm *bprm)
 * sched_process_exit(task_struct *p)
 * signal_generate(int sig, kernel_siginfo *info, task_struct *task,
 *                 int group, int result)
 * Source: Linux include/trace/events/{sched,signal}.h.
 * BTF is required. Only 16-byte comm is compared to a fixed class list; never emitted.
 * No filenames, argv, env or stacks read.
 * Event timestamps explicitly use CLOCK_MONOTONIC, excluding suspend.
 * nsecs(monotonic) is supported by v0.20.2 semantic_analyser.cpp.
 * Process start_ns/parent_start_ns/target_start_ns are CLOCK_BOOTTIME
 * (task start_boottime, including suspend); identity only, not event timing.
 * All process identities are host IDs plus task start_boottime. cgroup_id
 * belongs to current execution context, not necessarily the target task.
 * program_class=0 means unknown; comm classes are hints, not identity proof.
 * Fixed CPU-keyed maps, never PID-keyed; 256 lifecycle + 128 signal events/CPU/second maximum.
 * This is lossy observation, never a guarantee or a control interceptor.
 */

rawtracepoint:sched_process_fork
{
  $cpu = cpu;
  $second = nsecs(monotonic) / 1000000000;
  $kind = 0;
  if ($cpu < 4096) {
    @seen[$cpu] = @seen[$cpu] + 1;
    if (@epoch[$cpu, $kind] != $second) {
      @epoch[$cpu, $kind] = $second;
      @used[$cpu, $kind] = 0;
    }
    if (@used[$cpu, $kind] < 256) {
      @used[$cpu, $kind] = @used[$cpu, $kind] + 1;
      $p = (struct task_struct *)arg1;
      $class = 0;
      $name = $p->comm;
      if ($name == "systemd") { $class = 1; }
      else if ($name == "systemctl") { $class = 2; }
      else if ($name == "sudo") { $class = 3; }
      else if ($name == "sshd") { $class = 4; }
      else if ($name == "apt") { $class = 5; }
      else if ($name == "apt-get") { $class = 6; }
      else if ($name == "dpkg") { $class = 7; }
      else if ($name == "needrestart") { $class = 8; }
      else if ($name == "deb-systemd-inv") { $class = 9; }
      else if ($name == "invoke-rc.d") { $class = 10; }
      else if ($name == "service") { $class = 11; }
      else if ($name == "unattended-upgr") { $class = 12; }
      else if ($name == "Runner.Listener") { $class = 13; }
      else if ($name == "Runner.Worker") { $class = 14; }
      else if ($name == "runner.sh") { $class = 15; }
      else if ($name == "bash") { $class = 16; }
      else if ($name == "sh") { $class = 17; }
      else if ($name == "systemd-oomd") { $class = 18; }
      else if ($name == "reboot") { $class = 19; }
      else if ($name == "shutdown") { $class = 20; }
      $parent = (struct task_struct *)arg0;
      printf("KT1 F %llu %u %u %llu %u %u %llu %u %u %llu %u\n",
           nsecs(monotonic), $p->pid, $p->tgid, $p->start_boottime,
           $parent->pid, $parent->tgid, $parent->start_boottime,
           $p->cred->uid.val, $p->cred->gid.val, cgroup, $class);
    } else {
      @lifecycle_dropped[$cpu] = @lifecycle_dropped[$cpu] + 1;
    }
  }
}

rawtracepoint:sched_process_exec
{
  $cpu = cpu;
  $second = nsecs(monotonic) / 1000000000;
  $kind = 0;
  if ($cpu < 4096) {
    @seen[$cpu] = @seen[$cpu] + 1;
    if (@epoch[$cpu, $kind] != $second) {
      @epoch[$cpu, $kind] = $second;
      @used[$cpu, $kind] = 0;
    }
    if (@used[$cpu, $kind] < 256) {
      @used[$cpu, $kind] = @used[$cpu, $kind] + 1;
      $p = (struct task_struct *)arg0;
      $class = 0;
      $name = $p->comm;
      if ($name == "systemd") { $class = 1; }
      else if ($name == "systemctl") { $class = 2; }
      else if ($name == "sudo") { $class = 3; }
      else if ($name == "sshd") { $class = 4; }
      else if ($name == "apt") { $class = 5; }
      else if ($name == "apt-get") { $class = 6; }
      else if ($name == "dpkg") { $class = 7; }
      else if ($name == "needrestart") { $class = 8; }
      else if ($name == "deb-systemd-inv") { $class = 9; }
      else if ($name == "invoke-rc.d") { $class = 10; }
      else if ($name == "service") { $class = 11; }
      else if ($name == "unattended-upgr") { $class = 12; }
      else if ($name == "Runner.Listener") { $class = 13; }
      else if ($name == "Runner.Worker") { $class = 14; }
      else if ($name == "runner.sh") { $class = 15; }
      else if ($name == "bash") { $class = 16; }
      else if ($name == "sh") { $class = 17; }
      else if ($name == "systemd-oomd") { $class = 18; }
      else if ($name == "reboot") { $class = 19; }
      else if ($name == "shutdown") { $class = 20; }
      $parent = $p->real_parent;
      printf("KT1 E %llu %u %u %llu %u %u %llu %u %u %llu %u %u\n",
           nsecs(monotonic), $p->pid, $p->tgid, $p->start_boottime,
           $parent->pid, $parent->tgid, $parent->start_boottime,
           $p->cred->uid.val, $p->cred->gid.val, cgroup, $class, arg1);
    } else {
      @lifecycle_dropped[$cpu] = @lifecycle_dropped[$cpu] + 1;
    }
  }
}

rawtracepoint:sched_process_exit
{
  $cpu = cpu;
  $second = nsecs(monotonic) / 1000000000;
  $kind = 0;
  if ($cpu < 4096) {
    @seen[$cpu] = @seen[$cpu] + 1;
    if (@epoch[$cpu, $kind] != $second) {
      @epoch[$cpu, $kind] = $second;
      @used[$cpu, $kind] = 0;
    }
    if (@used[$cpu, $kind] < 256) {
      @used[$cpu, $kind] = @used[$cpu, $kind] + 1;
      $p = (struct task_struct *)arg0;
      $class = 0;
      $name = $p->comm;
      if ($name == "systemd") { $class = 1; }
      else if ($name == "systemctl") { $class = 2; }
      else if ($name == "sudo") { $class = 3; }
      else if ($name == "sshd") { $class = 4; }
      else if ($name == "apt") { $class = 5; }
      else if ($name == "apt-get") { $class = 6; }
      else if ($name == "dpkg") { $class = 7; }
      else if ($name == "needrestart") { $class = 8; }
      else if ($name == "deb-systemd-inv") { $class = 9; }
      else if ($name == "invoke-rc.d") { $class = 10; }
      else if ($name == "service") { $class = 11; }
      else if ($name == "unattended-upgr") { $class = 12; }
      else if ($name == "Runner.Listener") { $class = 13; }
      else if ($name == "Runner.Worker") { $class = 14; }
      else if ($name == "runner.sh") { $class = 15; }
      else if ($name == "bash") { $class = 16; }
      else if ($name == "sh") { $class = 17; }
      else if ($name == "systemd-oomd") { $class = 18; }
      else if ($name == "reboot") { $class = 19; }
      else if ($name == "shutdown") { $class = 20; }
      $parent = $p->real_parent;
      printf("KT1 X %llu %u %u %llu %u %u %llu %u %u %llu %u %d\n",
           nsecs(monotonic), $p->pid, $p->tgid, $p->start_boottime,
           $parent->pid, $parent->tgid, $parent->start_boottime,
           $p->cred->uid.val, $p->cred->gid.val, cgroup, $class, $p->exit_code);
    } else {
      @lifecycle_dropped[$cpu] = @lifecycle_dropped[$cpu] + 1;
    }
  }
}

rawtracepoint:signal_generate
{
  $cpu = cpu;
  $second = nsecs(monotonic) / 1000000000;
  $kind = 1;
  if ($cpu < 4096) {
    @seen[$cpu] = @seen[$cpu] + 1;
    if (@epoch[$cpu, $kind] != $second) {
      @epoch[$cpu, $kind] = $second;
      @used[$cpu, $kind] = 0;
    }
    if (@used[$cpu, $kind] < 128) {
      @used[$cpu, $kind] = @used[$cpu, $kind] + 1;
      $p = (struct task_struct *)curtask;
      $target = (struct task_struct *)arg2;
      $info = (struct kernel_siginfo *)arg1;
      $code = (int32)0;
      $code_known = 0;
      if (arg1 > 2) { $code = $info->si_code; $code_known = 1; }
      $class = 0;
      $name = $p->comm;
      if ($name == "systemd") { $class = 1; }
      else if ($name == "systemctl") { $class = 2; }
      else if ($name == "sudo") { $class = 3; }
      else if ($name == "sshd") { $class = 4; }
      else if ($name == "apt") { $class = 5; }
      else if ($name == "apt-get") { $class = 6; }
      else if ($name == "dpkg") { $class = 7; }
      else if ($name == "needrestart") { $class = 8; }
      else if ($name == "deb-systemd-inv") { $class = 9; }
      else if ($name == "invoke-rc.d") { $class = 10; }
      else if ($name == "service") { $class = 11; }
      else if ($name == "unattended-upgr") { $class = 12; }
      else if ($name == "Runner.Listener") { $class = 13; }
      else if ($name == "Runner.Worker") { $class = 14; }
      else if ($name == "runner.sh") { $class = 15; }
      else if ($name == "bash") { $class = 16; }
      else if ($name == "sh") { $class = 17; }
      else if ($name == "systemd-oomd") { $class = 18; }
      else if ($name == "reboot") { $class = 19; }
      else if ($name == "shutdown") { $class = 20; }
      $parent = $p->real_parent;
      printf("KT1 S %llu %u %u %llu %u %u %llu %u %u %llu %u %u %u %llu %d %d %d %d %d\n",
           nsecs(monotonic), $p->pid, $p->tgid, $p->start_boottime,
           $parent->pid, $parent->tgid, $parent->start_boottime,
           $p->cred->uid.val, $p->cred->gid.val, cgroup, $class, $target->pid, $target->tgid, $target->start_boottime, (int32)arg0, $code, (int32)arg3, (int32)arg4, $code_known);
    } else {
      @signal_dropped[$cpu] = @signal_dropped[$cpu] + 1;
    }
  }
}

interval:s:1
{
  printf("KT1 H %llu\n", nsecs(monotonic));
}

/* v0.20.2 supports profile on each CPU, but not map for-each syntax.
 * These maps contain ordinary integer values, not per-CPU count() values.
 * Counter samples are cumulative; userspace combines CPU deltas. CPU IDs
 * outside the bounded map range still produce a C record for gap reporting.
 */
profile:hz:1
{
  $cpu = cpu;
  if ($cpu < 4096) {
    printf("KT1 C %llu %u %llu %llu %llu\n", nsecs(monotonic), $cpu,
           @seen[$cpu], @lifecycle_dropped[$cpu], @signal_dropped[$cpu]);
  } else {
    printf("KT1 C %llu %u 0 0 0\n", nsecs(monotonic), $cpu);
  }
}

END
{
  clear(@epoch);
  clear(@used);
  clear(@seen);
  clear(@lifecycle_dropped);
  clear(@signal_dropped);
}
