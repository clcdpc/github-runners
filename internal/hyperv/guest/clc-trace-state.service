[Unit]
Description=CLC independent state diagnostic observer
After=systemd-journald.service dbus.service
Before=cloud-final.service clc-runner.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/clc/trace-state.py
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
UMask=0077
LogsDirectory=clc-diagnostics
LogsDirectoryMode=0700
StandardOutput=null
StandardError=journal
SyslogIdentifier=clc-trace-state
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10
LimitCORE=0
LimitMEMLOCK=64M
MemoryMax=64M
CPUQuota=5%
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
